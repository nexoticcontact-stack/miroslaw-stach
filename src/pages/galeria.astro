---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { gallery } from '../data/gallery';

const big = await Promise.all(gallery.map((g) => getImage({ src: g.src, width: 1600, format: 'webp', quality: 72 })));

const schema = [
  {
    '@type': 'ImageGallery',
    name: 'Realizacje – roboty ziemne, wyburzenia, mulczowanie',
    url: `${site.url}/galeria`,
    author: { '@id': `${site.url}/#firma` },
    image: gallery.map((g, i) => ({ '@type': 'ImageObject', contentUrl: new URL(big[i].src, site.url).href, caption: g.alt })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Realizacje', item: `${site.url}/galeria` },
    ],
  },
];
---

<Base
  title="Realizacje – roboty ziemne i wyburzenia | Mirosław Stach"
  description="Zdjęcia z realizacji: wykopy pod fundamenty, korytowanie i niwelacja, wyburzenia, mulczowanie terenu, praca ładowarek i wozideł. Przeginia, Olkusz, Kraków."
  schema={schema}
>
  <section class="page-head on-dark">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Strona główna</a></li>
        <li aria-current="page">Realizacje</li>
      </ol>
      <span class="eyebrow">{gallery.length} zdjęć z budów</span>
      <h1>Realizacje</h1>
      <p class="lead">Zdjęcia z prac wykonanych naszym sprzętem: wykopy, place i drogi, rozbiórki, mulczowanie terenu, transport materiałów. Kliknij zdjęcie, żeby je powiększyć.</p>
    </div>
  </section>
  <div class="hazard" aria-hidden="true"></div>

  <section class="section">
    <div class="wrap">
      <ul class="grid-gallery">
        {
          gallery.map((g, i) => (
            <li>
              <a href={big[i].src} data-lightbox data-alt={g.alt}>
                <figure>
                  <Image src={g.src} alt={g.alt} width={560} widths={[360, 560]} sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 25vw" loading={i < 6 ? 'eager' : 'lazy'} />
                  <figcaption>{g.alt}</figcaption>
                </figure>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta />
</Base>
