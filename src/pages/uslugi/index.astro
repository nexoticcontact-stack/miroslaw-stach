---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';
import { site } from '../../data/site';
import { services } from '../../data/services';
import { byFile } from '../../data/gallery';

const schema = [
  {
    '@type': 'ItemList',
    name: 'Usługi – Mirosław Stach Firma Usługowa',
    itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.h1, url: `${site.url}/uslugi/${s.slug}` })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Usługi', item: `${site.url}/uslugi` },
    ],
  },
];
---

<Base
  title="Usługi koparką, wyburzenia, wynajem maszyn | Mirosław Stach"
  description="Roboty ziemne i usługi koparką z operatorem, wyburzenia, mulczer leśny, wynajem ładowarek 8,5–25 t i wozideł 1,5–16 t, beczkowóz 10 000 l. Przeginia i okolice."
  schema={schema}
>
  <section class="page-head on-dark">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Strona główna</a></li>
        <li aria-current="page">Usługi</li>
      </ol>
      <span class="eyebrow">Oferta</span>
      <h1>Usługi koparką i maszynami budowlanymi</h1>
      <p class="lead">
        Wykonujemy prace ziemne, budowlane i drogowe: wykopy, korytowanie, niwelację, odwodnienia terenu i wyburzenia. Do tego wynajem ładowarek i wozideł, mulczowanie terenu i usługi ciągnikiem z beczkowozem.
      </p>
    </div>
  </section>
  <div class="hazard" aria-hidden="true"></div>

  <section class="section">
    <div class="wrap">
      {
        services.map((s, i) => {
          const c = byFile(s.cover);
          return (
            <article class="svc-row" id={s.slug}>
              <a class="svc-row__img" href={`/uslugi/${s.slug}`} tabindex="-1" aria-hidden="true">
                <Image src={c.src} alt="" width={800} widths={[480, 800]} sizes="(max-width: 860px) 100vw, 40vw" loading={i < 2 ? 'eager' : 'lazy'} />
              </a>
              <div class="svc-row__body">
                <span class="sheet__no">{s.no}</span>
                <h2><a href={`/uslugi/${s.slug}`}>{s.h1}</a></h2>
                <p>{s.lead}</p>
                <dl class="svc-row__specs">
                  {s.specs.map((sp) => <div><dt>{sp.label}</dt><dd>{sp.value}</dd></div>)}
                </dl>
                <a class="link-more" href={`/uslugi/${s.slug}`}>Szczegóły: {s.name.toLowerCase()} <Icon name="arrow" /></a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <Cta />
</Base>
