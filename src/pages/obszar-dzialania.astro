---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AreaMap from '../components/AreaMap.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import PageHead from '../components/PageHead.astro';
import { site, area } from '../data/site';
import { services } from '../data/services';

const km = (t: { lat: number; lon: number }) => {
  const dx = (t.lon - area.center.lon) * 71.5;
  const dy = (t.lat - area.center.lat) * 111.2;
  return Math.round(Math.sqrt(dx * dx + dy * dy));
};
const towns = [...area.towns].sort((a, b) => km(a) - km(b));

const faq = [
  { q: 'Czy dojeżdżacie do Olkusza i Krzeszowic?', a: 'Tak. Olkusz i Krzeszowice leżą kilkanaście kilometrów od naszej siedziby w Przegini.' },
  { q: 'Czy wykonujecie zlecenia w Krakowie?', a: 'Tak, szczególnie w zachodnich i północnych okolicach Krakowa (Zabierzów, Wielka Wieś). Szczegóły ustalamy telefonicznie.' },
  { q: 'Mojej miejscowości nie ma na liście – co wtedy?', a: 'Zadzwoń pod 794 742 706. Lista pokazuje najbliższe miejscowości, ale wykonujemy też zlecenia dalej.' },
];

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Obszar działania', item: `${site.url}/obszar-dzialania` },
    ],
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Base
  title="Usługi koparką Olkusz, Krzeszowice, Skała, Kraków – zasięg"
  description="Roboty ziemne i usługi koparką w okolicy Przegini: Olkusz, Krzeszowice, Skała, Jerzmanowice, Zabierzów, Trzebinia, Wolbrom, Kraków. Sprawdź, gdzie dojeżdżamy."
  schema={schema}
>
  <PageHead
    title="Obszar działania"
    lead="Siedziba firmy znajduje się w Przegini (gmina Jerzmanowice-Przeginia, powiat krakowski). Roboty ziemne, wyburzenia i wynajem maszyn wykonujemy w Olkuszu, Krzeszowicach, Skale, Zabierzowie i okolicach Krakowa."
    crumbs={[{ href: '/', label: 'Strona główna' }, { label: 'Obszar działania' }]}
  />

  <section class="section">
    <div class="wrap area">
      <div>
        <div class="section__intro">
          <h2>Gdzie dojeżdżamy</h2>
        </div>
        <ul class="km-list">
          {towns.map((t) => <li><span>{t.name}</span><span>ok. {km(t)} km</span></li>)}
        </ul>
        <p class="km-note">Odległości od Przegini w linii prostej, orientacyjne.</p>
      </div>
      <AreaMap />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section__intro"><h2>Nasze usługi w regionie</h2></div>
      <ul class="links">
        {services.map((s) => <li><a href={`/uslugi/${s.slug}`}><Icon name={s.icon} /> {s.name}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div class="section__intro"><h2>Pytania o dojazd</h2></div>
      <Faq items={faq} />
    </div>
  </section>

  <Cta />
</Base>
