---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';

const schema = [
  { '@type': 'ContactPage', name: 'Kontakt – Mirosław Stach Firma Usługowa', url: `${site.url}/kontakt`, about: { '@id': `${site.url}/#firma` } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Kontakt', item: `${site.url}/kontakt` },
    ],
  },
];
---

<Base
  title="Kontakt – Mirosław Stach Firma Usługowa | tel. 794 742 706"
  description="Kontakt z firmą Mirosław Stach Firma Usługowa: Przeginia 87, 32-049 Przeginia. Telefon 794 742 706, e-mail miroslawstach88@gmail.com. NIP 5130134954."
  schema={schema}
>
  <PageHead
    title="Masz pytanie?"
    lead="Skontaktuj się z nami, wybierając jeden z poniższych linków."
    crumbs={[{ href: '/', label: 'Strona główna' }, { label: 'Kontakt' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="tiles">
        <a class="tile" href={`tel:${site.phone}`}>
          <span class="tile__icon"><Icon name="phone" /></span>
          <span><small>Telefon</small><strong>{site.phoneDisplay}</strong></span>
        </a>
        <a class="tile" href={`mailto:${site.email}`}>
          <span class="tile__icon"><Icon name="mail" /></span>
          <span><small>E-mail</small><strong>{site.email}</strong></span>
        </a>
        <a class="tile" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
          <span class="tile__icon"><Icon name="pin" /></span>
          <span><small>Adres</small><strong>{site.address.postalCode} {site.address.street}</strong></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="dane-title">
    <div class="wrap two-col">
      <div class="section__intro">
        <h2 id="dane-title">Dane firmy</h2>
      </div>
      <dl class="company-data">
        <dt>Nazwa</dt><dd>{site.name}</dd>
        <dt>Adres</dt><dd>{site.address.street}, {site.address.postalCode} {site.address.city}</dd>
        <dt>Województwo</dt><dd>małopolskie</dd>
        <dt>NIP</dt><dd>{site.nip}</dd>
        <dt>Telefon</dt><dd><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd>
        <dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </dl>
    </div>
  </section>
</Base>
