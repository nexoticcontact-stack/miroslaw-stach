---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const schema = [
  {
    '@type': 'ContactPage',
    name: 'Kontakt – Mirosław Stach Firma Usługowa',
    url: `${site.url}/kontakt`,
    about: { '@id': `${site.url}/#firma` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Kontakt', item: `${site.url}/kontakt` },
    ],
  },
];
---

<Base
  title="Kontakt – Mirosław Stach, Przeginia 87 | tel. 794 742 706"
  description="Kontakt z firmą Mirosław Stach – roboty ziemne, wyburzenia, wynajem maszyn. Przeginia 87, 32-049 Przeginia. Tel. 794 742 706, e-mail miroslawstach88@gmail.com."
  schema={schema}
>
  <section class="page-head on-dark">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Strona główna</a></li>
        <li aria-current="page">Kontakt</li>
      </ol>
      <span class="eyebrow">Kontakt</span>
      <h1>Zadzwoń i opisz, co trzeba zrobić</h1>
      <p class="lead">Najszybciej przez telefon. Powiedz, jakie prace są do wykonania, gdzie i od kiedy. Dobierzemy sprzęt i ustalimy termin.</p>
    </div>
  </section>
  <div class="hazard" aria-hidden="true"></div>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <a class="contact-tile" href={`tel:${site.phone}`}>
          <span class="mono">Telefon</span>
          <strong>{site.phoneDisplay}</strong>
          <p>Wyceny, terminy, dostępność maszyn.</p>
        </a>
        <a class="contact-tile" href={`mailto:${site.email}`}>
          <span class="mono">E-mail</span>
          <strong class="lower">{site.email}</strong>
          <p>Możesz przesłać projekt, szkic albo zdjęcia terenu.</p>
        </a>
        <a class="contact-tile" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
          <span class="mono">Adres · mapa Google ↗</span>
          <strong>{site.address.street}</strong>
          <p>{site.address.postalCode} {site.address.city}, {site.address.commune}, {site.address.county}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--paper2" aria-labelledby="dane-title">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">Dane firmy</span>
        <h2 id="dane-title">{site.name}</h2>
      </div>
      <dl class="company-data">
        <dt>Nazwa</dt><dd>{site.name}</dd>
        <dt>Adres</dt><dd>{site.address.street}, {site.address.postalCode} {site.address.city}</dd>
        <dt>Gmina</dt><dd>Jerzmanowice-Przeginia, powiat krakowski</dd>
        <dt>Województwo</dt><dd>małopolskie</dd>
        <dt>NIP</dt><dd>{site.nip}</dd>
        <dt>Telefon</dt><dd><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd>
        <dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </dl>
    </div>
  </section>
</Base>
