---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <div class="faq__a">
          <p>{f.a}</p>
        </div>
      </details>
    ))
  }
</div>
