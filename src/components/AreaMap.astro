---
// Schematyczna mapa obszaru działania – czyste SVG, bez zewnętrznych map i skryptów.
import { area } from '../data/site';

const W = 520;
const H = 460;
const KM = 6.6; // px na km
const cx = W / 2;
const cy = H / 2;
const kmLon = 71.5; // km na stopień długości na tej szerokości
const kmLat = 111.2;

const project = (lat: number, lon: number) => ({
  x: cx + (lon - area.center.lon) * kmLon * KM,
  y: cy - (lat - area.center.lat) * kmLat * KM,
});
const towns = area.towns.map((t) => ({ ...t, ...project(t.lat, t.lon) }));
const rings = [10, 20, 30];
---

<svg class="area__map" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title map-desc">
  <title id="map-title">Schemat obszaru działania</title>
  <desc id="map-desc">Przeginia w centrum, okręgi co 10 km oraz pobliskie miejscowości: {area.towns.map((t) => t.name).join(', ')}.</desc>
  <line class="axis" x1={cx} y1="0" x2={cx} y2={H}></line>
  <line class="axis" x1="0" y1={cy} x2={W} y2={cy}></line>
  {
    rings.map((r) => (
      <g>
        <circle class="ring" cx={cx} cy={cy} r={r * KM} />
        <text class="ring-label" x={cx + 4} y={cy - r * KM - 4}>
          {r} KM
        </text>
      </g>
    ))
  }
  {
    towns.map((t) => (
      <g class="town">
        <circle cx={t.x} cy={t.y} r="3.5" />
        <text x={t.x + 8} y={t.y + 4}>
          {t.name}
        </text>
      </g>
    ))
  }
  <g class="center">
    <circle class="pulse" cx={cx} cy={cy} r="14" stroke-width="1.5"></circle>
    <circle cx={cx} cy={cy} r="6"></circle>
    <text x={cx - 20} y={cy - 12} text-anchor="end">Przeginia</text>
  </g>
  <text class="ring-label" x="8" y={H - 10}>N ↑ · SCHEMAT POGLĄDOWY</text>
</svg>
