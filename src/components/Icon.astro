---
// Proste ikony liniowe rysowane ręcznie (viewBox 48x48, obrys).
export type IconName =
  | 'phone' | 'arrow' | 'menu' | 'close' | 'mail' | 'pin' | 'check'
  | 'excavator' | 'wheel' | 'demolition' | 'mulcher' | 'loader' | 'dumper' | 'tractor';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls } = Astro.props;

const ui: Partial<Record<IconName, string>> = {
  phone: '<path d="M17 8h-5a3 3 0 0 0-3 3c0 15.5 12.5 28 28 28a3 3 0 0 0 3-3v-5l-8-3-3.5 3.5a22 22 0 0 1-9-9L23 16z"/>',
  arrow: '<path d="M9 24h28M27 14l10 10-10 10"/>',
  menu: '<path d="M8 13h32M8 24h32M8 35h32"/>',
  close: '<path d="M11 11l26 26M37 11L11 37"/>',
  mail: '<rect x="7" y="11" width="34" height="26" rx="3"/><path d="M8 13l16 13 16-13"/>',
  pin: '<path d="M24 43s13-11.5 13-22a13 13 0 1 0-26 0c0 10.5 13 22 13 22z"/><circle cx="24" cy="21" r="5"/>',
  check: '<path d="M9 25l9 9L39 13"/>',
};

const machines: Partial<Record<IconName, string>> = {
  // koparka gąsienicowa
  excavator:
    '<rect x="4" y="36" width="24" height="7" rx="3.5"/><path d="M8 36v-5h16v5"/><path d="M10 31v-9h9l3 9"/><path d="M19 22l9-12 10 5-4 9"/><path d="M34 24l5 6h-8"/>',
  // koparka kołowa
  wheel:
    '<circle cx="11" cy="39" r="4"/><circle cx="25" cy="39" r="4"/><path d="M5 35h26v-6H7z"/><path d="M10 29v-8h9l3 8"/><path d="M19 21l9-11 10 5-4 9"/><path d="M34 24l5 6h-8"/>',
  // wyburzenia – ściana z młotem
  demolition:
    '<path d="M5 42h20V24H5z"/><path d="M5 30h20M5 36h20M15 24v6M10 30v6M20 30v6M15 36v6"/><path d="M29 18l12-8M33 23l8-13"/><path d="M27 24l6-6 4 4-6 6z"/>',
  // mulczer – ciągnik z wirnikiem
  mulcher:
    '<circle cx="14" cy="36" r="7"/><circle cx="33" cy="39" r="4"/><path d="M14 29V15h12l4 10h7v10"/><path d="M18 15v10h12"/><path d="M37 32h7v10h-7"/><path d="M39 35l3 3M39 39l3-3"/>',
  // ładowarka kołowa
  loader:
    '<circle cx="12" cy="37" r="6"/><circle cx="30" cy="37" r="6"/><path d="M6 31h28v-8h-6l-2-8H14v16"/><path d="M34 25l6-5 4 3v9h-8"/>',
  // wozidło
  dumper:
    '<circle cx="12" cy="38" r="5"/><circle cx="36" cy="38" r="5"/><path d="M4 33h40v-5H4z"/><path d="M20 28l4-14h20l-4 14"/><path d="M8 28v-8h7v8"/>',
  // ciągnik z beczką
  tractor:
    '<circle cx="13" cy="35" r="8"/><circle cx="31" cy="39" r="4"/><path d="M13 27V12h10l3 11h9v12"/><path d="M17 12v11h9"/><rect x="36" y="22" width="10" height="11" rx="4"/>',
};

const body = ui[name] ?? machines[name] ?? '';
---

<svg class={cls} viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={body} />
