---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<a href="/" class:list={['brand', { 'brand--light': light }]} aria-label="Mirosław Stach – strona główna">
  <svg class="brand__mark" viewBox="0 0 48 40" aria-hidden="true">
    <path d="M2 38L18 6l8 16 5-8 15 24z" fill="#B55A08"></path>
    <path d="M18 6l8 16-6 16H2z" fill="currentColor" opacity=".9"></path>
  </svg>
  <span class="brand__text">
    <span class="brand__name">Mirosław <b>Stach</b></span>
    <span class="brand__sub">Firma Usługowa</span>
  </span>
</a>
