---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  crumbs: { href?: string; label: string }[];
  image?: ImageMetadata;
}
import { byFile } from '../data/gallery';
const { title, lead, crumbs, image = byFile('20230325_153138.jpg').src } = Astro.props;
---

<section class="page-head">
  {
    image && (
      <>
        <div class="hero__photo">
          <Image src={image} alt="" width={1600} widths={[640, 1000, 1600]} sizes="(max-width: 900px) 100vw, 52vw" quality={65} loading="eager" fetchpriority="high" />
        </div>
        <div class="hero__slash" aria-hidden="true" />
      </>
    )
  }
  <div class="wrap">
    <div class="page-head__text">
      <ol class="crumbs">
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
